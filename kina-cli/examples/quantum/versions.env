# versions.env — single source of truth for the pins this example needs.
# Sourced by lib.sh. All pins verified 2026-07-02 unless noted.

# Kueue: OCI Helm chart. Helm >=3.14 required for OCI install.
# https://github.com/kubernetes-sigs/kueue/releases + https://kueue.sigs.k8s.io/docs/installation/
KUEUE_CHART=oci://registry.k8s.io/kueue/charts/kueue
KUEUE_VERSION=0.18.2

# Base image for all simulator Dockerfiles. Pinned to the multi-arch index
# digest (resolves to linux/arm64 on Apple Silicon); verified 2026-07-11 via
# `docker buildx imagetools inspect`.
PYTHON_BASE_IMAGE=python:3.13.14-slim@sha256:eb43ff125d8d58d7449dcba7d336c23bcac412f526d861db493b9994d8010280

# Local image tag for all simulator images (built by build-images.sh).
SIM_IMAGE_TAG=0.1.0

# Simulator Python packages, verified 2026-07-02 via https://pypi.org/pypi/<pkg>/json
CIRQ_VERSION=1.7.0
PENNYLANE_QISKIT_VERSION=0.45.0
PENNYLANE_VERSION=0.45.1
QISKIT_AER_VERSION=0.17.2
QISKIT_VERSION=2.5.0
QSIMCIRQ_VERSION=0.22.0
